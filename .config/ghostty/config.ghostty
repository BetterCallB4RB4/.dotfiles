# Rosé Pine Ghostty configuration

theme = Rose Pine

# Rosé Pine surface — keep the theme palette, override only the background
background = #1f1d2e

# JetBrains Mono Nerd Font, slightly smaller than Ghostty's default (12)
font-family = JetBrainsMono Nerd Font Mono
font-size = 11

# Spacing / window look
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
window-decoration = false

# Convenience
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
shell-integration = detect

# Cursor
cursor-style = bar
cursor-style-blink = true

# Reload without restarting the terminal
keybind = ctrl+shift+,=reload_config
